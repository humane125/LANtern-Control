<Window x:Class="Lantern.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lantern.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LANtern Control"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <StreamGeometry x:Key="IconOverview">M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconActivity">M1,15 L5,11 L9,13 L14,5 L19,8</StreamGeometry>
        <StreamGeometry x:Key="IconAdapter">M2,3 H18 V8 H2 Z M2,12 H18 V17 H2 Z M15,5 H16 M15,14 H16</StreamGeometry>
        <StreamGeometry x:Key="IconDevice">M2,3 H18 V14 H2 Z M7,18 H13 M10,14 V18</StreamGeometry>
        <StreamGeometry x:Key="IconDownload">M10,2 V14 M5,10 L10,15 L15,10 M3,18 H17</StreamGeometry>
        <StreamGeometry x:Key="IconUpload">M10,18 V6 M5,10 L10,5 L15,10 M3,2 H17</StreamGeometry>
        <StreamGeometry x:Key="IconRules">M3,5 H17 M3,10 H17 M3,15 H17</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M10,1 L18,4 V9 C18,14 14.7,18 10,20 C5.3,18 2,14 2,9 V4 Z M7,10 L9,12 L14,7</StreamGeometry>
        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface"
                                        Property="Background"
                                        Value="{StaticResource AccentDark}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface"
                                        Property="Background"
                                        Value="#A31F34" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface"
                                        Property="Background"
                                        Value="#7C1425" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenteredGridTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CenteredActivityHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#0A090B" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActivityExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton Grid.Row="0"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          Focusable="True"
                                          HorizontalContentAlignment="Stretch"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleSurface"
                                                Padding="12,0,12,0"
                                                CornerRadius="9"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ChevronSurface"
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="7"
                                                        Background="{StaticResource AccentDark}"
                                                        BorderBrush="#522029"
                                                        BorderThickness="1">
                                                    <Path x:Name="Chevron"
                                                          Width="8"
                                                          Height="10"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M1,1 L6,5 L1,9"
                                                          Stroke="{StaticResource Accent}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Stretch="Uniform" />
                                                </Border>
                                                <ContentPresenter Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleSurface"
                                                        Property="Background"
                                                        Value="{StaticResource SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ChevronSurface"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron"
                                                        Property="Data"
                                                        Value="M1,2 L5,7 L9,2" />
                                                <Setter TargetName="ChevronSurface"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent"
                                              Grid.Row="1"
                                              HorizontalAlignment="Stretch"
                                              ContentSource="Content"
                                              Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandedContent"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LimitEditorBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactLimitTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryText}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="CustomTitleBar"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#09090B"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Orientation="Horizontal">
                    <controls:RedWatcherLogo Width="24"
                                             Height="24"
                                             VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Text="LANtern Control"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="MinimizeWindowButton"
                        Grid.Column="1"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize window"
                        Click="MinimizeWindowButton_OnClick">
                    <Path Width="11"
                          Height="1"
                          Data="M0,0.5 H11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Stretch="Fill" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Grid.Column="2"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Maximize or restore window"
                        Click="MaximizeWindowButton_OnClick">
                    <Grid Width="13" Height="13">
                        <Path Data="M1,1 H12 V12 H1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M3,1 H12 V10 H10 M1,3 H10 V12 H1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              StrokeLineJoin="Miter"
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
                <Button x:Name="CloseWindowButton"
                        Grid.Column="3"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close window"
                        Click="CloseWindowButton_OnClick">
                    <Path Width="11"
                          Height="11"
                          Data="M1,1 L10,10 M10,1 L1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="Sidebar"
                Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24">
                <Border DockPanel.Dock="Bottom"
                        Margin="0,16,0,0"
                        Padding="13"
                        CornerRadius="10"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,7,0"
                                     Fill="{StaticResource Success}" />
                            <TextBlock Text="LOCAL PROCESSING"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0"
                                   Text="No router login required"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Traffic stays on this PC"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="2,0,0,34" Orientation="Horizontal">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="14"
                                Background="{StaticResource AccentDark}"
                                BorderBrush="{StaticResource Accent}"
                                BorderThickness="1">
                            <controls:RedWatcherLogo x:Name="BrandLogo"
                                                     Width="50"
                                                     Height="50"
                                                     AutomationProperties.Name="LANtern Control Red Watcher logo" />
                        </Border>
                        <StackPanel Margin="12,7,0,0">
                            <TextBlock Text="LANtern"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock Text="CONTROL"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="14,0,0,10"
                               Text="WORKSPACE"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <Button x:Name="OverviewNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="OverviewSection"
                            Click="NavigationButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="25" Height="20">
                                <Path Width="16"
                                      Height="16"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconOverview}"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=WebsiteActivitySection}"
                                                             Value="Visible">
                                                    <Setter Property="Fill" Value="{StaticResource SecondaryText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=DomainRulesSection}"
                                                             Value="Visible">
                                                    <Setter Property="Fill" Value="{StaticResource SecondaryText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <TextBlock Text="Overview" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ActivityNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="WebsiteActivitySection"
                            Click="NavigationButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="25" Height="20">
                                <Path Width="17"
                                      Height="17"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconActivity}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource SecondaryText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=WebsiteActivitySection}"
                                                             Value="Visible">
                                                    <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <TextBlock Text="Visited domains" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DomainRulesNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="DomainRulesSection"
                            Click="NavigationButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="25" Height="20">
                                <Path Width="17"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconShield}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource SecondaryText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=DomainRulesSection}"
                                                             Value="Visible">
                                                    <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <TextBlock Text="Domain rules" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26,30,20">
                <Grid x:Name="OverviewSection">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NETWORK CONTROL"
                                   Foreground="{StaticResource Accent}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Network overview"
                                   FontSize="27"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Monitor and control devices on your local network"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="13" />
                    </StackPanel>
                    <Border x:Name="TopStatusBadge"
                            Grid.Column="1"
                            Padding="14,9"
                            VerticalAlignment="Top"
                            CornerRadius="18"
                            Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot"
                                     Width="9"
                                     Height="9"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="TopStatusText"
                                       Text="Idle"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="AdapterStrip"
                        Margin="12,24,12,18"
                        Padding="22"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*" MinWidth="280" />
                            <ColumnDefinition Width="1*" MinWidth="210" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NETWORK ADAPTER"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="AdapterSelector"
                                      Margin="0,8,22,0"
                                      MinWidth="250"
                                      SelectionChanged="AdapterSelector_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="{StaticResource SecondaryText}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="8,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="LocalIpBlock"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="LOCAL IP"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LocalIpText"
                                           Margin="0,6,0,0"
                                           Text="-"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="GATEWAY"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="GatewayIpText"
                                           Margin="0,6,0,0"
                                           Text="-"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button x:Name="StartButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="StartButton_OnClick"
                                    Content="Start control" />
                            <Button x:Name="ScanButton"
                                    Click="ScanButton_OnClick"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    Content="Refresh devices" />
                            <Button x:Name="StopButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="StopButton_OnClick"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    Content="Stop &amp; restore" />
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:ResponsiveUniformGrid x:Name="MetricsPanel"
                                                Breakpoint="900"
                                                WideColumns="4"
                                                Rows="0">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CONNECTED DEVICES"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ConnectedDevicesMetric"
                                           Margin="0,8,0,2"
                                           Text="0"
                                           FontSize="25"
                                           FontWeight="Bold" />
                                <TextBlock Text="active clients"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentDark}">
                                <Path Width="19"
                                      Height="19"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconDevice}"
                                      Stroke="{StaticResource Accent}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DOWNLOAD"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DownloadMetric"
                                           Margin="0,8,0,2"
                                           Text="0 B/s"
                                           FontSize="25"
                                           FontWeight="Bold" />
                                <TextBlock Text="current total"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                            </StackPanel>
                            <Path Grid.Column="1"
                                  Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource IconDownload}"
                                  Stroke="{StaticResource DownloadAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="UPLOAD"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="UploadMetric"
                                           Margin="0,8,0,2"
                                           Text="0 B/s"
                                           FontSize="25"
                                           FontWeight="Bold" />
                                <TextBlock Text="current total"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                            </StackPanel>
                            <Path Grid.Column="1"
                                  Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource IconUpload}"
                                  Stroke="{StaticResource UploadAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACTIVE LIMITS"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ActiveRulesMetric"
                                           Margin="0,8,0,2"
                                           Text="0"
                                           FontSize="25"
                                           FontWeight="Bold" />
                                <TextBlock Text="device rules"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentDark}">
                                <Path Width="19"
                                      Height="19"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconRules}"
                                      Stroke="{StaticResource UploadAccent}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>
                </controls:ResponsiveUniformGrid>

                <Border x:Name="ActivitySection"
                        Margin="0,6,12,18"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="20,18,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LIVE THROUGHPUT"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Network activity"
                                           FontSize="18"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource DownloadAccent}" />
                                <TextBlock Margin="6,0,16,0"
                                           Text="Download"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                                <Ellipse Width="7" Height="7" Fill="{StaticResource UploadAccent}" />
                                <TextBlock Margin="6,0,16,0"
                                           Text="Upload"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" />
                                <TextBlock Margin="6,0,0,0"
                                           Text="1 sec live"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <Separator Grid.Row="1" Background="{StaticResource Border}" />
                        <controls:LiveTrafficChart x:Name="TrafficChart"
                                                   Grid.Row="2"
                                                   Height="238"
                                                   Margin="20,10,20,14" />
                        <Border Grid.Row="3"
                                Padding="20,12"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ChartRangeText"
                                           Text="Last 1 hour  •  1 second samples"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="11" />
                                <TextBlock x:Name="ChartTopDeviceText"
                                           Grid.Column="1"
                                           Margin="20,0,0,0"
                                           HorizontalAlignment="Right"
                                           Text="Waiting for device traffic"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="WebsiteActivitySection"
                        Margin="12,0,12,18"
                        Style="{StaticResource CardBorderStyle}"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="20,18,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VISITED DOMAINS"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Visited domains"
                                           FontSize="24"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Open a connected device to inspect the domains LANtern can observe."
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="WebsiteActivityCountText"
                                       Grid.Column="1"
                                       Margin="16,0,16,0"
                                       VerticalAlignment="Center"
                                       Text="0 domains"
                                       Foreground="{StaticResource SecondaryText}" />
                            <Button x:Name="ClearActivityButton"
                                    Grid.Column="2"
                                    Margin="0"
                                    MinHeight="34"
                                    Padding="13,6"
                                    VerticalAlignment="Center"
                                    Click="ClearActivityButton_OnClick"
                                    Content="Clear activity" />
                        </Grid>
                        <Separator Grid.Row="1" Background="{StaticResource Border}" />
                        <Grid Grid.Row="2">
                            <ItemsControl x:Name="WebsiteActivityDeviceList"
                                          MinHeight="260"
                                          Margin="16,10,16,16"
                                          ItemsSource="{Binding DeviceActivityGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                CornerRadius="9"
                                                Background="{StaticResource InputBackground}"
                                                BorderBrush="{StaticResource Border}"
                                                BorderThickness="1">
                                            <Expander Style="{StaticResource ActivityExpanderStyle}"
                                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                <Expander.Header>
                                                    <Grid Margin="14,11,16,11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30"
                                                                Height="30"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="8"
                                                                Background="{StaticResource AccentDark}">
                                                            <Path Width="16"
                                                                  Height="16"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Data="{StaticResource IconDevice}"
                                                                  Stroke="{StaticResource Accent}"
                                                                  StrokeThickness="1.7"
                                                                  Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       Text="{Binding IpAddress}"
                                                                       Foreground="{StaticResource SecondaryText}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="16,0,20,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding DomainCountText}"
                                                                   Foreground="{StaticResource Accent}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="3"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding LastSeenText}"
                                                                   Foreground="{StaticResource SecondaryText}"
                                                                   FontSize="11" />
                                                    </Grid>
                                                </Expander.Header>
                                                <Grid Margin="12,0,12,12">
                                                    <DataGrid ItemsSource="{Binding Domains}"
                                                              MaxHeight="318"
                                                              RowHeight="54"
                                                              ColumnHeaderHeight="40"
                                                              AutoGenerateColumns="False"
                                                              CanUserSortColumns="False"
                                                              CanUserResizeColumns="False"
                                                              EnableRowVirtualization="True"
                                                              GridLinesVisibility="None"
                                                              AlternationCount="2"
                                                              Background="#0A090B"
                                                              BorderBrush="{StaticResource Border}"
                                                              BorderThickness="1"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              IsReadOnly="True">
                                                        <DataGrid.Style>
                                                            <Style TargetType="DataGrid"
                                                                   BasedOn="{StaticResource {x:Type DataGrid}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDomains}"
                                                                                 Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.Style>
                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader"
                                                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="Padding" Value="16,0" />
                                                                <Setter Property="Background" Value="#0A090B" />
                                                                <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                                                                <Setter Property="FontSize" Value="10" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </Style>
                                                        </DataGrid.ColumnHeaderStyle>
                                                        <DataGrid.CellStyle>
                                                            <Style TargetType="DataGridCell"
                                                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                                <Setter Property="Padding" Value="16,0" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            </Style>
                                                        </DataGrid.CellStyle>
                                                        <DataGrid.RowStyle>
                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="Background" Value="#0D0C0E" />
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="AlternationIndex" Value="1">
                                                                        <Setter Property="Background" Value="#110E11" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentDark}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                        <DataGrid.Columns>
                                                            <DataGridTemplateColumn Header="DOMAIN" Width="3.1*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="14,0,0,0"
                                                                              ToolTip="{Binding Domain}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="34" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Width="26"
                                                                                    Height="26"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Center"
                                                                                    CornerRadius="7"
                                                                                    Background="{StaticResource AccentDark}"
                                                                                    BorderBrush="#522029"
                                                                                    BorderThickness="1">
                                                                                <Path Width="13"
                                                                                      Height="13"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Data="{StaticResource IconActivity}"
                                                                                      Stroke="{StaticResource Accent}"
                                                                                      StrokeThickness="1.8"
                                                                                      StrokeStartLineCap="Round"
                                                                                      StrokeEndLineCap="Round"
                                                                                      Stretch="Uniform" />
                                                                            </Border>
                                                                            <TextBlock Grid.Column="1"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding Domain}"
                                                                                       Foreground="{StaticResource PrimaryText}"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Header="SIGNAL"
                                                                                    HeaderStyle="{StaticResource CenteredActivityHeaderStyle}"
                                                                                    Width="1.1*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding SourceLabel}"
                                                                                   Foreground="{StaticResource Accent}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Header="LAST OBSERVED"
                                                                                    HeaderStyle="{StaticResource CenteredActivityHeaderStyle}"
                                                                                    Width="1.25*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Orientation="Horizontal">
                                                                            <Ellipse Width="5"
                                                                                     Height="5"
                                                                                     Margin="0,0,8,0"
                                                                                     Fill="{StaticResource Accent}" />
                                                                            <TextBlock Text="{Binding LastSeenText}"
                                                                                       Foreground="{StaticResource PrimaryText}"
                                                                                       FontFamily="Consolas"
                                                                                       FontSize="11" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Header="HITS"
                                                                                    HeaderStyle="{StaticResource CenteredActivityHeaderStyle}"
                                                                                    Width="0.65*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding HitCount}"
                                                                                   Foreground="{StaticResource PrimaryText}"
                                                                                   FontFamily="Consolas"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Header="ACTION"
                                                                                    HeaderStyle="{StaticResource CenteredActivityHeaderStyle}"
                                                                                    Width="0.9*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button MinWidth="72"
                                                                                MinHeight="32"
                                                                                Margin="8,0"
                                                                                Padding="12,5"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Tag="{Binding}"
                                                                                IsEnabled="{Binding CanBlock}"
                                                                                Click="BlockVisitedDomainButton_OnClick"
                                                                                Content="{Binding BlockActionText}" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock Margin="14,18"
                                                               HorizontalAlignment="Center"
                                                               Text="No domains observed for this device yet."
                                                               Foreground="{StaticResource SecondaryText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDomains}"
                                                                                 Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="WebsiteActivityEmptyState"
                                        Margin="0,54,0,48"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="No connected devices"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Start control and wait for devices to appear."
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="3"
                                Padding="20,11"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="Domain metadata only  •  HTTPS pages, passwords, searches, and messages remain encrypted"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="DomainRulesSection"
                        Margin="12,0,12,18"
                        Style="{StaticResource CardBorderStyle}"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="20,18,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACCESS CONTROL"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Domain rules"
                                           FontSize="24"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Block a domain for one device without decrypting HTTPS traffic."
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="DomainRuleCountText"
                                       Grid.Column="1"
                                       Margin="18,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="0 rules"
                                       Foreground="{StaticResource SecondaryText}" />
                        </Grid>
                        <Separator Grid.Row="1" Background="{StaticResource Border}" />
                        <Border Grid.Row="2"
                                Margin="20,18,20,0"
                                Padding="16"
                                CornerRadius="9"
                                Background="#160B0E"
                                BorderBrush="#522029"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="210" />
                                    <ColumnDefinition Width="1.15*" MinWidth="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="DEVICE"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <ComboBox x:Name="DomainPresetDeviceSelector"
                                              Margin="0,7,0,0"
                                              MinHeight="44"
                                              ItemsSource="{Binding DomainRuleDevices}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Device for app preset" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="APP PRESET"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <ComboBox x:Name="DomainPresetSelector"
                                              Margin="0,7,0,0"
                                              MinHeight="44"
                                              ItemsSource="{Binding DomainPresets}"
                                              DisplayMemberPath="Name"
                                              SelectedIndex="0"
                                              AutomationProperties.Name="App blocking preset" />
                                </StackPanel>
                                <Button x:Name="ApplyDomainPresetButton"
                                        Grid.Column="2"
                                        MinWidth="126"
                                        MinHeight="44"
                                        Padding="16,9"
                                        Margin="0,17,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ApplyDomainPresetButton_OnClick"
                                        Content="Apply preset" />
                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Margin="2,11,0,0">
                                    <TextBlock Text="Blocks the app's related services and disables QUIC for this device so traffic falls back to inspectable TLS."
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DomainPresetValidationText"
                                               Margin="0,5,0,0"
                                               Text="Choose a device and an app preset."
                                               Foreground="{StaticResource Accent}"
                                               FontSize="10"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3"
                                Margin="20,18,20,16"
                                Padding="16"
                                CornerRadius="9"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="210" />
                                    <ColumnDefinition Width="1.6*" MinWidth="280" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="DEVICE"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <ComboBox x:Name="DomainRuleDeviceSelector"
                                              Margin="0,7,0,0"
                                              ItemsSource="{Binding DomainRuleDevices}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Device to block a domain for" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="DOMAIN"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="DomainRuleInput"
                                             Margin="0,7,0,0"
                                             MinHeight="44"
                                             Padding="12,8"
                                             AutomationProperties.Name="Domain to block"
                                             ToolTip="Example: youtube.com" />
                                    <TextBlock x:Name="DomainRuleValidationText"
                                               Margin="2,6,0,0"
                                               Text="Enter a valid domain such as example.com."
                                               Foreground="{StaticResource Accent}"
                                               FontSize="10"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="AddDomainRuleButton"
                                        Grid.Column="2"
                                        MinWidth="112"
                                        MinHeight="44"
                                        Padding="16,9"
                                        VerticalAlignment="Top"
                                        Margin="0,17,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddDomainRuleButton_OnClick"
                                        Content="Add block" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="4" MinHeight="250">
                            <ItemsControl x:Name="DomainRulesList"
                                          Margin="20,0,20,18"
                                          ItemsSource="{Binding DomainRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="16,13"
                                                CornerRadius="9"
                                                Background="#0D0C0E"
                                                BorderBrush="{StaticResource Border}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="1.7*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30"
                                                        Height="30"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="8"
                                                        Background="{StaticResource AccentDark}">
                                                    <Path Width="15"
                                                          Height="16"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="{StaticResource IconShield}"
                                                          Stroke="{StaticResource Accent}"
                                                          StrokeThickness="1.7"
                                                          StrokeLineJoin="Round"
                                                          Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Domain}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding DeviceName}"
                                                               Foreground="{StaticResource SecondaryText}"
                                                               FontSize="10" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Margin="18,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="SCOPE"
                                                               Foreground="{StaticResource SecondaryText}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding ScopeText}"
                                                               Foreground="{StaticResource Accent}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        MinWidth="82"
                                                        MinHeight="34"
                                                        Padding="13,6"
                                                        VerticalAlignment="Center"
                                                        Tag="{Binding}"
                                                        Click="RemoveDomainRuleButton_OnClick"
                                                        Content="Remove" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="DomainRulesEmptyState"
                                        Margin="0,50"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="42"
                                        Height="42"
                                        HorizontalAlignment="Center"
                                        CornerRadius="11"
                                        Background="{StaticResource AccentDark}">
                                    <Path Width="20"
                                          Height="21"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource IconShield}"
                                          Stroke="{StaticResource Accent}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" />
                                </Border>
                                <TextBlock Margin="0,13,0,0"
                                           HorizontalAlignment="Center"
                                           Text="No blocked domains"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Choose a connected device and add a domain above."
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="5"
                                Padding="20,11"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="Blocks DNS, visible TLS hostnames, and plain HTTP  •  VPNs, encrypted DNS, and ECH can bypass domain rules"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="DeviceSection"
                        Margin="0,0,12,0"
                        Style="{StaticResource CardBorderStyle}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="20,18,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NETWORK CLIENTS"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Connected devices"
                                           FontSize="18"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceCountText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="0 devices"
                                       Foreground="{StaticResource SecondaryText}" />
                        </Grid>
                        <Separator Grid.Row="1" Background="{StaticResource Border}" />

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="DeviceGrid"
                                      MinHeight="270"
                                      MaxHeight="430"
                                      ItemsSource="{Binding Devices}"
                                      AutoGenerateColumns="False"
                                      AlternationCount="2"
                                      CanUserSortColumns="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="DEVICE" Width="2.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30"
                                                            Height="30"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="8"
                                                            Background="{StaticResource AccentDark}">
                                                        <Path Width="16"
                                                              Height="16"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="{StaticResource IconDevice}"
                                                              Stroke="{StaticResource Accent}"
                                                              StrokeThickness="1.7"
                                                              StrokeLineJoin="Round"
                                                              Stretch="Uniform" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBox Padding="0"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 CaretBrush="{StaticResource Accent}"
                                                                 FocusVisualStyle="{x:Null}"
                                                                 FontWeight="SemiBold"
                                                                 Foreground="{StaticResource PrimaryText}"
                                                                 IsEnabled="{Binding CanControl}"
                                                                 Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                                                                 ToolTip="Click to rename this device" />
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding MacAddress}"
                                                                       Foreground="{StaticResource SecondaryText}"
                                                                       FontSize="10" />
                                                            <TextBlock Margin="8,0,0,0"
                                                                       Text="{Binding ProtectedReason}"
                                                                       Foreground="{StaticResource Accent}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="IP ADDRESS"
                                                        Width="1.05*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                        Binding="{Binding IpAddress}" />
                                    <DataGridTextColumn Header="DOWNLOAD"
                                                        Width="1*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                        Binding="{Binding DownloadRate}" />
                                    <DataGridTextColumn Header="UPLOAD"
                                                        Width="1*"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource CenteredGridTextStyle}"
                                                        Binding="{Binding UploadRate}" />
                                    <DataGridTemplateColumn Header="DOWN LIMIT" Width="1.35*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="14,0,8,0"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanControl}"
                                                        Style="{StaticResource LimitEditorBorderStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="LimitEditor"
                                                                 Style="{StaticResource CompactLimitTextBoxStyle}"
                                                                  ToolTip="0 means unlimited; live two-way monitoring remains active"
                                                                 Text="{Binding DownloadLimit, UpdateSourceTrigger=PropertyChanged, Delay=350}" />
                                                        <Border Grid.Column="1"
                                                                Margin="0,7"
                                                                Background="{StaticResource Border}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="7,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="KB/s"
                                                                   Foreground="{StaticResource SecondaryText}"
                                                                   FontSize="10" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="UP LIMIT" Width="1.35*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="14,0,8,0"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanControl}"
                                                        Style="{StaticResource LimitEditorBorderStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="LimitEditor"
                                                                 Style="{StaticResource CompactLimitTextBoxStyle}"
                                                                  ToolTip="0 means unlimited; live two-way monitoring remains active"
                                                                 Text="{Binding UploadLimit, UpdateSourceTrigger=PropertyChanged, Delay=350}" />
                                                        <Border Grid.Column="1"
                                                                Margin="0,7"
                                                                Background="{StaticResource Border}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="7,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="KB/s"
                                                                   Foreground="{StaticResource SecondaryText}"
                                                                   FontSize="10" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="INTERNET" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="14,0,0,0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource SwitchCheckBoxStyle}"
                                                          Content="Paused"
                                                          IsEnabled="{Binding CanControl}"
                                                          IsChecked="{Binding PauseInternet, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Pause stops forwarding traffic for this device" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel x:Name="EmptyState"
                                        Margin="0,70,0,70"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="46"
                                        Height="46"
                                        HorizontalAlignment="Center"
                                        CornerRadius="13"
                                        Background="{StaticResource SurfaceRaised}">
                                    <Path Width="22"
                                          Height="22"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource IconDevice}"
                                          Stroke="{StaticResource Accent}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" />
                                </Border>
                                <TextBlock Margin="0,12,0,0"
                                           Text="No devices observed yet"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Choose an adapter and start control to observe this LAN."
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Padding="16,12"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailStatusText"
                                           Text="Ready. No router login is required."
                                           Foreground="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="UptimeText"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           Text="Idle"
                                           Foreground="{StaticResource SecondaryText}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
