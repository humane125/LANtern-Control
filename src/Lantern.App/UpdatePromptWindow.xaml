<Window x:Class="Lantern.App.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lantern.App.Controls"
        Title="LANtern Control update"
        Width="560"
        Height="390"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource PrimaryText}"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="18"
            CornerRadius="18"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#6E1828"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Opacity="0.65"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="18,18,0,0"
                    Background="#0D0B0E"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <StackPanel Margin="16,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" />
                        <TextBlock Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="LANtern Control  •  Update signal" />
                    </StackPanel>
                    <Button Width="42"
                            Height="34"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            FontSize="20"
                            Content="×"
                            Click="NotNowButton_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="104"
                        Height="104"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="26"
                        Background="#1B0A0F"
                        BorderBrush="#7F1729"
                        BorderThickness="1">
                    <controls:RedWatcherLogo Margin="8" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,3,0,0">
                    <TextBlock Foreground="{StaticResource Accent}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="NEW VERSION DETECTED" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="27"
                               FontWeight="Bold"
                               Text="A new signal is live." />
                    <TextBlock Margin="0,9,0,0"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap">
                        A newer LANtern Control release is available on GitHub.
                        Review the release and choose when you want to install it.
                    </TextBlock>
                    <Border Margin="0,16,0,0"
                            Padding="13,10"
                            CornerRadius="8"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource SecondaryText}"
                                           FontSize="9"
                                           Text="INSTALLED" />
                                <TextBlock x:Name="InstalledVersionText"
                                           Margin="0,3,0,0"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="15,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="18"
                                       Text="→" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource SecondaryText}"
                                           FontSize="9"
                                           Text="AVAILABLE" />
                                <TextBlock x:Name="AvailableVersionText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource Accent}"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="14,9"
                            Foreground="{StaticResource SecondaryText}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Content="Never ask again"
                            Click="NeverAskAgainButton_OnClick" />
                    <Button Grid.Column="2"
                            MinWidth="104"
                            Margin="0,0,10,0"
                            Content="Not now"
                            Click="NotNowButton_OnClick" />
                    <Button Grid.Column="3"
                            MinWidth="136"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="View update"
                            Click="UpdateButton_OnClick" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
