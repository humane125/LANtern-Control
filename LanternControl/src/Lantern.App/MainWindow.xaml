<Window x:Class="Lantern.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LANtern Control"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="{StaticResource AccentDark}"
                            BorderBrush="{StaticResource Accent}"
                            BorderThickness="1">
                        <Path Width="20"
                              Height="20"
                              Stretch="Uniform"
                              Stroke="{StaticResource Accent}"
                              StrokeThickness="1.8"
                              Data="M2,14 L2,9 L6,9 L6,14 M8,14 L8,5 L12,5 L12,14 M14,14 L14,1 L18,1 L18,14 M1,16 L19,16" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="LANtern Control"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="Router-independent LAN bandwidth control"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="12,8"
                    CornerRadius="16"
                    Background="{StaticResource SurfaceRaised}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot"
                             Width="9"
                             Height="9"
                             Margin="0,0,8,0"
                             Fill="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="TopStatusText"
                               Text="Idle"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,24,0,16"
                Padding="18"
                CornerRadius="12"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NETWORK ADAPTER"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="AdapterSelector"
                              Margin="0,7,18,0"
                              MinWidth="520"
                              SelectionChanged="AdapterSelector_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#111827"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="#526274"
                                               FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button x:Name="StartButton"
                            Click="StartButton_OnClick"
                            Background="{StaticResource AccentDark}"
                            BorderBrush="{StaticResource Accent}"
                            Content="Start control" />
                    <Button x:Name="ScanButton"
                            Click="ScanButton_OnClick"
                            IsEnabled="False"
                            Content="Refresh devices" />
                    <Button x:Name="StopButton"
                            Click="StopButton_OnClick"
                            IsEnabled="False"
                            BorderBrush="#6A3440"
                            Content="Stop &amp; restore" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Padding="12,10"
                CornerRadius="8"
                Background="#102338"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Width="18"
                      Height="18"
                      Margin="2,0,10,0"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Stroke="{StaticResource Accent}"
                      StrokeThickness="1.8"
                      Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M8,5 L8,9 M8,12 L8,12.2" />
                <TextBlock Grid.Column="1"
                           Text="IPv4 control works while this app is running. Devices must share this LAN; guest isolation or ARP protection can block control."
                           Foreground="#B9CBDC"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                CornerRadius="12"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="DeviceGrid"
                          ItemsSource="{Binding Devices}"
                          AutoGenerateColumns="False"
                          AlternationCount="2"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="DEVICE" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProtectedReason}"
                                                   Foreground="{StaticResource SecondaryText}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="IP ADDRESS"
                                            Width="1.1*"
                                            IsReadOnly="True"
                                            Binding="{Binding IpAddress}" />
                        <DataGridTextColumn Header="MAC ADDRESS"
                                            Width="1.35*"
                                            IsReadOnly="True"
                                            Binding="{Binding MacAddress}" />
                        <DataGridTextColumn Header="DOWNLOAD"
                                            Width="1*"
                                            IsReadOnly="True"
                                            Binding="{Binding DownloadRate}" />
                        <DataGridTextColumn Header="UPLOAD"
                                            Width="1*"
                                            IsReadOnly="True"
                                            Binding="{Binding UploadRate}" />
                        <DataGridTemplateColumn Header="DOWN LIMIT (KB/s)" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Width="92"
                                             HorizontalAlignment="Left"
                                             IsEnabled="{Binding CanControl}"
                                             ToolTip="0 means unlimited"
                                             Text="{Binding DownloadLimit, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="UP LIMIT (KB/s)" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Width="92"
                                             HorizontalAlignment="Left"
                                             IsEnabled="{Binding CanControl}"
                                             ToolTip="0 means unlimited"
                                             Text="{Binding UploadLimit, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PAUSE INTERNET" Width="1.05*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              IsEnabled="{Binding CanControl}"
                                              IsChecked="{Binding PauseInternet, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Drop this device's IPv4 internet traffic while control is active" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="No devices observed yet"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Choose an adapter and start control to observe this LAN."
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DetailStatusText"
                       Text="Ready. No router login is required."
                       Foreground="{StaticResource SecondaryText}" />
            <TextBlock x:Name="DeviceCountText"
                       Grid.Column="1"
                       Text="0 devices"
                       Foreground="{StaticResource SecondaryText}" />
        </Grid>
    </Grid>
</Window>
